    "./typeclass": "./src/typeclass.ts",
    "./typeclasses": "./src/typeclasses.ts",
    "./maybe": "./src/maybe.ts",
    "./either": "./src/either.ts",
    "./validation": "./src/validation.ts",
    "./identity": "./src/identity.ts",
    "./fn": "./src/fn.ts",
    "./tuple": "./src/tuple.ts",
    "./array": "./src/array.ts",
    "./array_buffer": "./src/array_buffer.ts",
    "./async_iterable": "./src/async_iterable.ts",
    "./data_view": "./src/data_view.ts",
    "./date": "./src/date.ts",
    "./error": "./src/error.ts",
    "./form_data": "./src/form_data.ts",
    "./iterable": "./src/iterable.ts",
    "./map": "./src/map.ts",
    "./readable_stream": "./src/readable_stream.ts",
    "./record": "./src/record.ts",
    "./regexp": "./src/regexp.ts",
    "./set": "./src/set.ts",
    "./typed_array": "./src/typed_array.ts",
    "./url_search_params": "./src/url_search_params.ts",
    "./weak_map": "./src/weak_map.ts",
    "./weak_set": "./src/weak_set.ts",
    "./predicate": "./src/predicate.ts",
    "./task": "./src/task.ts",
    "./effects": "./src/effects.ts",
    "./quickcheck": "./src/quickcheck.ts",
    "./except": "./src/except.ts",
    "./parallel": "./src/parallel.ts",
    "./stm": "./src/stm.ts",
    "./reader": "./src/reader.ts",
    "./state": "./src/state.ts",
    "./writer": "./src/writer.ts",
    "./chunk_log": "./src/chunk_log.ts",
    "./list": "./src/list.ts",
    "./tagged": "./src/tagged.ts",
    "./loop": "./src/loop.ts",
    "./transform": "./tools/transform_do_program.ts",
    "./transform/plugin": "./tools/transform_plugin.ts",
    "./typeclasses/alternative": "./src/typeclasses/alternative.ts",
    "./typeclasses/applicative": "./src/typeclasses/applicative.ts",
    "./typeclasses/arrow": "./src/typeclasses/arrow.ts",
    "./typeclasses/bifunctor": "./src/typeclasses/bifunctor.ts",
    "./typeclasses/category": "./src/typeclasses/category.ts",
    "./typeclasses/comonad": "./src/typeclasses/comonad.ts",
    "./typeclasses/contravariant": "./src/typeclasses/contravariant.ts",
    "./typeclasses/eq": "./src/typeclasses/eq.ts",
    "./typeclasses/foldable": "./src/typeclasses/foldable.ts",
    "./typeclasses/functor": "./src/typeclasses/functor.ts",
    "./typeclasses/monad": "./src/typeclasses/monad.ts",
    "./typeclasses/monad_error": "./src/typeclasses/monad_error.ts",
    "./typeclasses/monad_rec": "./src/typeclasses/monad_rec.ts",
    "./typeclasses/monoid": "./src/typeclasses/monoid.ts",
    "./typeclasses/ord": "./src/typeclasses/ord.ts",
    "./typeclasses/parse": "./src/typeclasses/parse.ts",
    "./typeclasses/profunctor": "./src/typeclasses/profunctor.ts",
    "./typeclasses/semigroup": "./src/typeclasses/semigroup.ts",
    "./typeclasses/show": "./src/typeclasses/show.ts",
    "./typeclasses/traversable": "./src/typeclasses/traversable.ts",
    "./handlers": "./src/handlers.ts"
  },
  "publish": {
    "include": [
      "LICENSE",
      "LLMS.md",
      "README.md",
      "deno.json",
      "deno.lock",
      "src/**/*.ts",
      "learn_you_a_typeclasses_for_greater_good/README.md",
      "learn_you_a_typeclasses_for_greater_good/**/*.ts",
      "tools/transform_do_program.ts",
      "tools/transform_iterable_maps.ts",
      "tools/transform_plugin.ts",
      "tools/transform_bindings.ts",
      "tools/transform_ast.ts",
      "tools/transform_context.ts",
      "tools/transform_imports.ts",
      "tools/transform_generator.ts",
      "tools/transform_terminals.ts"
    ],
    "exclude": [
      "src/*.test.ts",
      "tools/*checks.ts",
      "tools/*.test.ts"
    ]
  },
  "imports": {
    "effect": "npm:effect@3.21.4",
    "esbuild": "npm:esbuild@0.25.12",
    "esrap": "npm:esrap@2.4.0",
    "fp-ts/Either": "npm:fp-ts@2.16.11/lib/Either.js",
    "fp-ts/Option": "npm:fp-ts@2.16.11/lib/Option.js",
    "fp-ts/ReaderTaskEither": "npm:fp-ts@2.16.11/lib/ReaderTaskEither.js",
    "fp-ts/StateReaderTaskEither": "npm:fp-ts@2.16.11/lib/StateReaderTaskEither.js",
    "fp-ts/function": "npm:fp-ts@2.16.11/lib/function.js",
    "miniflare": "npm:miniflare@4.20260730.0",
    "oxc-parser": "npm:oxc-parser@0.154.0",
    "oxc-transform": "npm:oxc-transform@0.154.0",
    "purify-ts/Either": "npm:purify-ts@2.1.4/Either",
    "purify-ts/Maybe": "npm:purify-ts@2.1.4/Maybe",
    "rolldown": "npm:rolldown@1.1.5",
    "typescript": "npm:typescript@5.9.3",
    "true-myth/maybe": "npm:true-myth@9.1.0/maybe",
    "true-myth/result": "npm:true-myth@9.1.0/result"
  },
  "tasks": {
    "bench": "deno bench --allow-ffi --allow-env --allow-read --allow-write=/tmp,/var/tmp bench/*.bench.ts",
    "bench:case-studies": "deno bench --allow-ffi --allow-env --allow-read --allow-write=/tmp,/var/tmp bench/case_studies_transformer.bench.ts",
    "bench:scaling": "deno bench bench/scaling.bench.ts",
    "case-study": "deno run --allow-read case_studies/main.ts",
    "transform": "deno run --allow-ffi --allow-env --allow-read --allow-write tools/transform_do_program.ts",
    "check:portability": "deno run --allow-ffi --allow-env --allow-read tools/check_portability.ts",
    "test:entrypoints": "deno run --allow-ffi --allow-env --allow-read tools/package_entrypoint_smoke.ts",
    "test:node": "node --experimental-strip-types tools/node_portability_smoke.ts",
    "test:bun": "bun tools/node_portability_smoke.ts",
    "test:browser": "deno run --allow-env --allow-net=127.0.0.1 --allow-read --allow-run --allow-write=/tmp,/var/tmp tools/browser_portability_smoke.ts",
    "test:workerd": "deno run --allow-env --allow-net=127.0.0.1 --allow-read --allow-run --allow-write=/tmp,/var/tmp tools/workerd_portability_smoke.ts",
    "test:mutations": "deno run --allow-env --allow-read --allow-run --allow-write=/tmp,/var/tmp tools/mutation_checks.ts",
    "publish": "deno task prepublish && deno publish",
    "publish:dry-run": "deno publish --dry-run --allow-dirty",
    "fmt:check": "deno fmt --check",
    "doc:check": "deno doc --lint src/mod.ts tools/transform_do_program.ts tools/transform_plugin.ts",
    "check": "deno check src/mod.ts src/*.test.ts examples/*.ts case_studies/**/*.ts bench/*.bench.ts tools/*.ts learn_you_a_typeclasses_for_greater_good/**/*.ts",
    "example": "deno run --allow-read=examples,src examples/main.ts",
    "learn": "deno run learn_you_a_typeclasses_for_greater_good/main.ts",
    "test": "deno test --clean --coverage=/var/tmp/typeclasses-coverage --coverage-threshold=70 src examples case_studies",
    "test:transformer": "deno test --allow-env --allow-ffi --allow-read --allow-run --allow-write tools/transform_do_program_checks.ts tools/transform_plugin_checks.ts tools/transform_iterable_maps_checks.ts tools/transform_optimization_checks.ts tools/transform_round2_checks.ts tools/round3_transform_checks.ts tools/oxc_ast_checks.ts tools/oxc_generator_checks.ts tools/oxc_terminal_checks.ts tools/oxc_portability_checks.ts tools/oxc_integration_checks.ts",
    "test:benchmarks": "deno bench --allow-ffi --allow-env --allow-read --allow-write=/tmp,/var/tmp --filter '/$a/' bench/algorithm_contexts.bench.ts bench/iterable_pipeline.bench.ts bench/scaling.bench.ts bench/do_vs_program.bench.ts bench/case_studies_transformer.bench.ts bench/large_chains_comparison.bench.ts",
    "verify": "deno task fmt:check && deno task check && deno lint && deno task doc:check && deno task check:docs && deno task test && deno task test:experiments && deno task test:tools && deno task test:mutations && deno task test:transformer && deno task test:benchmarks && deno task check:portability && deno task test:entrypoints && deno task test:package && deno task test:node && deno task test:bun && deno task test:browser && deno task test:workerd && deno task example && deno task learn && deno task case-study",
    "prepublish": "deno task verify && deno task publish:dry-run",
    "check:core": "deno check src/*.ts",
    "test:core": "deno test --no-check src",
    "dev": "deno task check:core && deno lint src && deno task test:core",
    "types:bench": "deno run --allow-env --allow-read tools/type_budget.ts",
    "bench:choices": "deno bench bench/collection_choices.bench.ts bench/runtime_hills.bench.ts",
    "check:budgets": "deno run --allow-env --allow-read --allow-run tools/check_budgets.ts",
    "check:toolchains": "deno run --allow-env --allow-read --allow-run tools/check_toolchains.ts",
    "check:docs": "deno run --allow-read tools/sync_examples.ts --check",
    "docs:sync": "deno run --allow-read --allow-write=README.md,LLMS.md tools/sync_examples.ts",
    "dev:watch": "deno run --allow-read --allow-run tools/dev_watch.ts --watch",
    "test:package": "deno run --allow-env --allow-read --allow-run --allow-write=/tmp,/var/tmp tools/package_consumer.ts",
    "check:affected": "deno run --allow-read --allow-run tools/dev_watch.ts",
    "test:tools": "deno test --allow-ffi --allow-env --allow-read --allow-run tools/dev_watch.test.ts tools/round2_qualification_checks.ts tools/bundle_round2_checks.ts tools/round3_core_checks.ts",
    "test:experiments": "deno test bench/experiments",
    "profile:allocation": "node --experimental-strip-types tools/allocation_profile.ts"
  }
}
